# PostgreSQL connection string
# For local: postgresql://user:password@localhost:5432/tara_db
# For Neon: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/tara_db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/tara_db

# OpenAI API key for Tara agent
OPENAI_API_KEY=sk-...

# Model to use (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Server port (defaults to 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Data directory for ingestion (defaults to ./data/sample_a)
DATA_DIR=./data/sample_a

# Log level (debug | info | warn | error)
LOG_LEVEL=info
