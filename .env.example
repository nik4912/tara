# PostgreSQL connection string
# For local Docker: postgresql://tara:tara123@localhost:5432/tara_db
# For Neon:         postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/tara_db?sslmode=require
DATABASE_URL=postgresql://tara:tara123@localhost:5432/tara_db

# Groq API key — free at https://console.groq.com
GROQ_API_KEY=gsk_...

# Groq model (default: Llama 4 Scout — best tool-calling support on Groq)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Server port (defaults to 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Data directory for ingestion
# Use a specific path:  ./data/sample_a
# Use "all" to load all three datasets at once
DATA_DIR=./data/sample_a

# Log level (debug | info | warn | error)
LOG_LEVEL=info
